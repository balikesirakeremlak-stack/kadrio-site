# ============================================================
# KADRIO - Professional Production Environment Configuration
# ============================================================

# === CORE APPLICATION ===
# Environment mode: development or production
NODE_ENV=production

# Server port
PORT=3000

# === SECURITY (REQUIRED) ===
# Must be different in production, at least 16 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=your_long_random_admin_token_minimum_16_chars
SESSION_SECRET=your_different_long_random_session_secret_minimum_16_chars

# === CORS & NETWORKING ===
# CORS origin: false (disable) for production, true for development, or specific URL
CORS_ORIGIN=https://kadrio.co

# === DATABASE & STORAGE ===
# Database file path (SQLite)
DB_PATH=./database/reeloram.db

# Upload directory for video files
UPLOAD_DIR=./uploads

# === LOGGING ===
# Log level: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Directory for log files
LOG_DIR=./logs

# === PAYMENT & MONETIZATION ===
# Payment provider: iyzico, stripe, or custom
PAYMENT_PROVIDER=iyzico

# Shopier checkout URL for single product
PAYMENT_LINK_URL=https://www.shopier.com/kadrio/50337921

# Product configuration
SINGLE_PRODUCT_NAME=Kadrio Tek Ürün
SINGLE_PRODUCT_PRICE=99

# === THIRD-PARTY INTEGRATIONS (OPTIONAL) ===
# Iyzico Payment API credentials
# IYZICO_API_KEY=your_api_key
# IYZICO_SECRET_KEY=your_secret_key
# IYZICO_BASE_URL=https://sandbox-api.iyzico.com

# Stripe payment integration
# STRIPE_SECRET_KEY=sk_live_...

# Cloudinary for persistent video storage
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# PostgreSQL (for future scaling)
# DATABASE_URL=postgres://user:pass@host:5432/kadrio

# === PERFORMANCE TUNING ===
# Request timeout in milliseconds
REQUEST_TIMEOUT_MS=30000

# Rate limiting window in milliseconds
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=120
