# Kadrio production environment example
ADMIN_TOKEN=replace_with_secure_token
SESSION_SECRET=replace_with_a_long_random_secret
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://your-domain.example
DB_PATH=./database/reeloram.db
UPLOAD_DIR=./uploads
# Payment integration is disabled until a verified provider account is configured.
PAYMENT_PROVIDER=iyzico
# Optional: verified Shopier/payment-link URL for manual sponsor payments.
# The app redirects here only after saving the sponsor request.
# PAYMENT_LINK_URL=https://www.shopier.com/...
# IYZICO_API_KEY=...
# IYZICO_SECRET_KEY=...
# IYZICO_BASE_URL=https://sandbox-api.iyzico.com
# STRIPE_SECRET_KEY=sk_test_...
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# VIDEO_STORAGE_URL=https://your-storage-provider.example
# Optional persistent video storage (Cloudinary).
# CLOUDINARY_CLOUD_NAME=...
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
